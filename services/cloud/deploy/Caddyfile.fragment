# Control TLS only; HAProxy owns public 443. Certificates provisioned by deploy.
# Merge this block into the one existing Caddy global options block.
{
    auto_https disable_redirects
    servers 127.0.0.1:9443 {
        protocols h1 h2
        listener_wrappers {
            proxy_protocol {
                allow 127.0.0.1/32
                fallback_policy reject
            }
            tls
        }
    }
}
https://api.example.com:9443 {
    bind 127.0.0.1
    tls /etc/weftmate/api/fullchain.pem /etc/weftmate/api/key.pem
    reverse_proxy 127.0.0.1:8787 {
        header_up Host api.example.com
        header_up X-Forwarded-Host api.example.com
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
        header_up -Forwarded
    }
}
