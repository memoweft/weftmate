# Copy manually to /etc/weftmate-cloud/cloud.env; never commit the real file.
CLOUD_HOST=127.0.0.1
CLOUD_PORT=8787
CLOUD_DATA_DIR=/var/lib/weftmate-cloud
CLOUD_ISSUER=https://api.example.com/personal/v1/cloud/oidc
CLOUD_OIDC_CLIENTS=[]
# Enable only behind a loopback proxy that overwrites forwarding headers.
CLOUD_TRUST_PROXY=true
# Development delivery only; real Resend requires explicit sender + runtime key.
CLOUD_MAIL_TRANSPORT=file
CLOUD_MAIL_FROM=WeftMate <no-reply@example.com>
