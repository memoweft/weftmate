# Documentation only: Node does not load this file automatically.
CLOUD_HOST=127.0.0.1
CLOUD_PORT=8787
CLOUD_DATA_DIR=.runtime
CLOUD_ISSUER=http://localhost:8787/personal/v1/cloud/oidc
CLOUD_OIDC_CLIENTS=[{"client_id":"example-native","redirect_uris":["com.example.weftmate:/callback"]}]
CLOUD_TRUST_PROXY=false
CLOUD_MAIL_TRANSPORT=file
CLOUD_MAIL_FROM=WeftMate <no-reply@example.com>
# CLOUD_MAIL_DIR defaults to CLOUD_DATA_DIR/mail-outbox
# Resend requires an explicitly configured sender and CLOUD_RESEND_API_KEY.
# Do not enable it in tests or commit a real key.
