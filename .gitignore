# ── Dependencies ──
node_modules/

# ── Build / packaging output ──
dist/
release/
out/

# ── Local user data & secrets ──
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.env
.env.*
!.env.example

# ── Local tooling / scratch ──
*.log
dogfood*.mjs
.tmp/
# 注意:上面是 `.tmp/`(带点)。工具/技能默认往【不带点】的 tmp/ 和 output/ 写产物
#   (docx/pdf 等生成物、渲染中间件),它们曾以未跟踪目录出现在 git status 里,
#   一次 `git add -A` 就会把个人文件写进 git 历史——推上去很难干净删除。两条都挡住:
tmp/
output/

# ── dogfood 隔离实例的数据/配置/密钥(绝不进仓;run.mjs 和 PROTOCOL.md 照常进仓) ──
dogfood/data/

# ── AI 助手的本地工作流：只在本机存在，绝不进仓、绝不上远端 ──
#   本仓此前【没有任何】这类防护，只是碰巧还没出现 .claude/ 目录。
#   (对照 memoweft: 那边靠 .git/info/exclude 挡着，但那是本机私有文件、不随克隆走。)
#   注意 AGENTS.md / CURRENT.md / PROJECT_ANALYSIS.md / dogfood/PROTOCOL.md 是【项目本体文档】，
#   照常进仓，不在此列。
.claude/
.codex/
.cursor/
.cursorrules
.windsurfrules
.aider*
.mcp.json
CLAUDE.md
CLAUDE.local.md
AGENTS.local.md

# ── OS / editor cruft ──
.DS_Store
Thumbs.db
.idea/
.vscode/
