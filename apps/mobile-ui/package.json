{
  "name": "weftmate-mobile-ui",
  "private": true,
  "version": "0.2.0",
  "description": "Offline Weave UI bundled into Android and published by the personal host",
  "scripts": {
    "build": "esbuild src/vendor.js --bundle --minify --format=iife --global-name=WeftFormat --outfile=www/vendor.js",
    "check": "node --check www/app.js",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "dompurify": "3.2.6",
    "esbuild": "^0.28.2",
    "highlight.js": "11.11.1",
    "markdown-it": "14.1.0"
  }
}
