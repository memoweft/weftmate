{
  "name": "weftmate-mobile-ui",
  "private": true,
  "version": "0.8.0",
  "description": "Offline Weave UI bundled into Android and published by the personal host",
  "scripts": {
    "build": "esbuild src/vendor.js --bundle --minify --format=iife --global-name=WeftFormat --outfile=www/vendor.js && node src/build-ui-core.mjs",
    "build:cloud": "node src/build-cloud.mjs",
    "check": "node src/check.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "dompurify": "3.2.6",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "6.2.4",
    "highlight.js": "11.11.1",
    "markdown-it": "14.1.0",
    "playwright": "1.58.2",
    "qrcode": "1.5.4"
  }
}
