      {
        "callId": "call_8c33719102424b7581e0960e",
        "name": "write",
        "arguments": {
          "file_path": "C:\\temp\\weftmate-eval-action-04-research-script-wb3KL1\\sum.mjs",
          "content": "// 读取 sales.csv，按商品汇总营业额（小计 = 单价 × 数量），写入 result.json\n// 只用 Node.js 内置模块 node:fs，无需安装任何第三方包\n// 参考：https://nodejs.org/learn/manipulating-files/reading-files-with-nodejs\nimport { readFileSync, writeFileSync } from 'node:fs';\n\nconst csvPath = new URL('./sales.csv', import.meta.url);\nconst jsonPath = new URL('./result.json', import.meta.url);\n\n// 按 utf8 读取整个文本文件（fs.readFileSync，同步返回字符串）\nconst text = readFileSync(csvPath, 'utf8');\n\nconst lines = text.split(/\\r?\\n/).map((l) => l.trim()).filter((l) => l.length > 0);\nconst header = lines[0].split(',');\nconst iName = header.indexOf('商品');\nconst iPrice = header.indexOf('单价');\nconst iQty = header.indexOf('数量');\n\nif (iName < 0 || iPrice < 0 || iQty < 0) {\n  throw new Error(`CSV 表头不符合预期: ${lines[0]}`);\n}\n\nconst items = [];\nconst byName = new Map();\nlet total = 0;\n\nfor (const line of lines.slice(1)) {\n  const cols = line.split(',');\n  const name = cols[iName].trim();\n  const price = Number(cols[iPrice]);\n  const qty = Number(cols[iQty]);\n  if (!name || !Number.isFinite(price) || !Number.isFinite(qty)) continue;\n\n  const subtotal = price * qty;\n  const prev = byName.get(name);\n  if (prev) {\n    prev.数量 += qty;\n    prev.小计 = Math.round((prev.小计 + subtotal) * 100) / 100;\n  } else {\n    const item = { 商品: name, 单价: price, 数量: qty, 小计: subtotal };\n    byName.set(name, item);\n    items.push(item);\n  }\n  total += subtotal;\n}\n\nconst result = {\n  明细: items.map((it) => ({ ...it, 小计: Math.round(it.小计 * 100) / 100 })),\n  合计: Math.round(total * 100) / 100,\n};\n\nwriteFileSync(jsonPath, JSON.stringify(result, null, 2) + '\\n', 'utf8');\n\nconsole.log(JSON.stringify(result, null, 2));\n"
        },
